# Transport: stdio (single user, default) or http (multi-user)
MCP_TRANSPORT=stdio

# Required only for stdio mode
LOSEIT_EMAIL=
LOSEIT_PASSWORD=

# Shared Lose It options
LOSEIT_TIMEZONE=America/Chicago
LOSEIT_REQUEST_TIMEOUT_MS=15000
LOSEIT_GWT_AUTOFETCH=true

# Optional stdio session cache
LOSEIT_SESSION_PATH=~/.loseit-mcp/session.json

# Required only for HTTP mode
# MCP_PUBLIC_URL=https://loseit-mcp.example.com
# MCP_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters

# Optional HTTP settings
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3000
# MCP_DATA_PATH=~/.loseit-mcp/server.enc.json
# MCP_ALLOWED_HOSTS=loseit-mcp.example.com
# MCP_TRUST_PROXY=true

# Optional GWT-RPC overrides. Explicit values override live auto-discovery.
# LOSEIT_GWT_POLICY_HASH=
# LOSEIT_GWT_PERMUTATION=
